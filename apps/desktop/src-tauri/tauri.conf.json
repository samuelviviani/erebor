{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Erebor",
  "version": "0.1.2",
  "identifier": "org.erebor.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Erebor",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 580,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "license": "MIT",
    "shortDescription": "Mining manager: transparent, non-custodial, local-first.",
    "longDescription": "Erebor manages CPU mining through XMRig. It never holds funds or private keys; rewards are paid by the pool directly to the user's wallet."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxMERENTdGREY4RTJBOUQKUldTZEtvN2ZmOVVOQVMzTlJvRmYrNVdJZFZQeW5GVzRic0ZNTXl5bStMNWJXR0VIRjFCQUNLOHUK",
      "endpoints": ["https://github.com/samuelviviani/erebor/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
