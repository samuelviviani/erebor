{
  "name": "erebor",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @erebor/desktop tauri dev",
    "dev:web": "pnpm --filter @erebor/website dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "check": "pnpm -r typecheck && pnpm -r test && pnpm lint:rust && cargo test --workspace && pnpm audit --prod && cargo audit"
  }
}
