<?xml version="1.0" encoding="UTF-8"?>
<!-- Erebor Agent as a macOS LaunchAgent (per user, no admin rights). Installed by
     scripts/install-agent.sh; or copy to ~/Library/LaunchAgents and
     `launchctl load -w ~/Library/LaunchAgents/org.erebor.agent.plist`.
     Logs: ~/Library/Logs/erebor-agent.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.erebor.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__/erebor-agent</string>
    <string>start</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/erebor-agent.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/erebor-agent.log</string>
</dict>
</plist>
